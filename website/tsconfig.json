{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "halo-island": ["../packages/halo-island/src/spec.ts"],
      "@halo/icons": ["../packages/halo-island/src/icons.ts"]
    }
  },
  "include": ["src", "../example/catalog.ts", "../example/brands.ts"]
}
