{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "default"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    },
    "simulator": {
      "channel": "production",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
